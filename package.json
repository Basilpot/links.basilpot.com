{
  "name": "linkbio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "prisma generate && vinext build",
    "preview": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "import": "node --env-file=.env scripts/migrate-pg-to-d1.mjs",
    "import:images": "node --env-file=.env scripts/migrate-images.mjs",
    "smoke": "node --env-file=.env scripts/smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-d1": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vinext/cloudflare": "1.0.0-beta.9",
    "@workos-inc/authkit-nextjs": "^4.3.2",
    "@workos-inc/node": "^10.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-server-dom-webpack": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "wrangler": "^4.137.0"
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module"
}
