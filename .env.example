# Postgres source for the Neon → D1 import script (scripts/migrate-pg-to-d1.mjs). Optional after import.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkbio"

# Server secrets — same values reach the Worker: locally via .dev.vars, in production via `wrangler secret put`.
APP_SIGNING_SECRET="replace-with-random-32-byte-secret"
WORKOS_CLIENT_ID=""
WORKOS_API_KEY=""
WORKOS_COOKIE_PASSWORD="replace-with-random-32-byte-secret"
ANALYTICS_SECRET="replace-with-separate-random-32-byte-secret"

# Public values mirrored in wrangler.jsonc vars.
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/auth/callback"
NEXT_PUBLIC_APP_URL="http://localhost:3000"